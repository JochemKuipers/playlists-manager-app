{
  "name": "playlists-manager-app",
  "description": "A Spicetify custom-app created with @spicetify/creator",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "sc": "spicetify-creator",
    "dev": "spicetify-creator dev",
    "build": "spicetify-creator build",
    "update-types": "spicetify-creator update-types",
    "clean-spice": "spicetify-creator clean-spicetify --all",
    "lint": "biome check --write src/api src/operations src/store src/components src/app.tsx src/css src/extension",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@spicemod/creator": "0.0.38",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
